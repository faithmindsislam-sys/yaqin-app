# Copy this template to the root .env and configure your own project.
# Keep the configured .env local; never commit credentials.
# Only NEXT_PUBLIC_* values are bundled into the browser. Never prefix secrets with NEXT_PUBLIC_.

# Accounts: get both values from the SAME Supabase project (Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects can use NEXT_PUBLIC_SUPABASE_ANON_KEY instead of the publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=

# Local frontend/API. Production: override API_BASE to empty for same-origin /api routing.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
NEXT_PUBLIC_API_ENABLED=true
# Canonical Quran source. Builds need read access to this S3 prefix (Python + boto3).
QURAN_S3_URI=s3://yaqin-resources-744172873146/resources/quran/
NEXT_PUBLIC_QURAN_BASE=https://www.yaqeenguide.com/data
NEXT_PUBLIC_QURAN_AUDIO_BASE=https://www.yaqeenguide.com/resources
ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
ENV=local
DEV_ROLE=

# Optional persistent backend. URL-encode the password in the transaction pooler URL.
DATABASE_URL=
SUPABASE_JWT_SECRET=

# Optional Google provisioning; unnecessary when sharing an already-configured Supabase project.
# These are private values used ONLY by npm run auth:configure, never by the frontend.
# Filling them does not enable the hosted provider until auth:configure -- --apply is run.
SUPABASE_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SITE_URL=http://localhost:3100
# Comma-separated exact redirects; existing hosted redirects are preserved when applying.
AUTH_REDIRECT_URLS=http://localhost:3100/auth/callback/,http://localhost:3100/reset-password/,http://127.0.0.1:3100/auth/callback/,http://127.0.0.1:3100/reset-password/

# Optional AI providers (login does not require AWS).
AWS_REGION=eu-west-1
BEDROCK_REGION=us-east-1
# Required for runtime generation/publication safety, including when Mantle is used.
# Published Standard-tier policy supporting English/Arabic; see docs/RUNTIME_SAFETY.md.
GUARDRAIL_ID=
GUARDRAIL_VERSION=
YAQIN_AWS_PROFILE=
# Hassan/reviewer model. Interactive tutor routing, answers, practice and support review are
# pinned to Sonnet 5.5 in code; TUTOR_MODEL_ID and FAST_MODEL_ID environment values are ignored.
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
RAG_SERVICE_URL=
TUTOR_RATE_PER_MINUTE=12
PUBLIC_API_RATE_PER_MINUTE=60
PUBLIC_API_SERVICE_RATE_PER_MINUTE=500
# Set the public endpoint to enable anonymous MCP with guest/shared quotas.
# MCP_RESOURCE_URL=https://public-api.yaqeenguide.com/api/v1/mcp/
MCP_RESOURCE_URL=
# Include the exact ALB DNS hostname when CloudFront does not forward viewer Host.
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
RETRIEVAL_K=8
VECTOR_FLOOR=0.32
# Optional absolute paths; blank CONTENT_DIR uses the repository's content directory.
# CONTENT_DIR=/absolute/path/to/content
# YAQIN_RESOURCES_DIR is only an explicit offline authoring/test override; normal builds use S3.

# Optional deployment settings.
ORIGIN_VERIFY=

# Conservative shared admission reservations; apply reviewed sql/operational_budgets.sql separately.
TUTOR_SECONDS=55
TUTOR_TOKENS=200000
TUTOR_MODEL_CALLS=4
REVIEW_SECONDS=180
REVIEW_TOKENS=800000
REVIEW_MODEL_CALLS=12
COURSE_SECONDS=480
COURSE_TOKENS=3000000
COURSE_MODEL_CALLS=32
USER_DAILY_TOKENS=10000000
SERVICE_DAILY_TOKENS=100000000
SERVICE_RATE_PER_MINUTE=500
