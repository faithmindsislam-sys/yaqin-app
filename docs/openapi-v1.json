  "info": {
    "description": "Read published courses and approved sources, or ask the tutor in English and Arabic.\n\nIn [Swagger](/api/v1/swagger), click **Authorize** and paste only your access token (without `Bearer`) to try requests.\n\n[Developer guide](/api/v1/docs) · [Full schema reference](/api/v1/reference)",
    "title": "Yaqeen Public API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/courses": {
      "get": {
        "operationId": "courses_courses_get",
        "parameters": [
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 25,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "track",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "explore",
                    "first-steps",
                    "deepen"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Track"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "items": [
                    {
                      "id": "example-course",
                      "level": 1,
                      "minutes": 4,
                      "status": "published",
                      "subject": "belief",
                      "summary": {
                        "ar": "استجابة توضيحية.",
                        "en": "Illustrative response."
                      },
                      "title": {
                        "ar": "دورة نموذجية",
                        "en": "Example course"
                      },
                      "tracks": [
                        "explore"
                      ]
                    }
                  ],
                  "limit": 25,
                  "offset": 0,
                  "total": 1
                },
                "schema": {
                  "$ref": "#/components/schemas/CoursePage"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Content Too Large"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List published courses",
        "tags": [
          "Courses"
        ]
      }
    },
