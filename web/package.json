    "build": "next build --webpack",
    "lint": "eslint",
    "pretypecheck": "node scripts/bundle-content.mjs",
    "check:source-quotes": "node scripts/check-source-quotes.mjs",
    "check:courses": "node scripts/check-courses.mjs",
