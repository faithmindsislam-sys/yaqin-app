    "check:onboarding": "node scripts/check-onboarding.mjs",
    "check:auth": "node scripts/check-auth.mjs",
    "check:settings": "node scripts/check-settings.mjs",
    "auth:check": "node scripts/google-auth.mjs",
    "auth:configure": "node scripts/google-auth.mjs --plan",
    "check:env": "node scripts/check-env.mjs",
    "check:knowledge-base": "node scripts/check-knowledge-base.mjs",
    "check:tracks": "node scripts/check-tracks.mjs",
    "check:faith": "node scripts/check-faith.mjs",
    "check:first-steps": "node scripts/check-first-steps.mjs",
    "check:worship": "node scripts/check-worship.mjs",
